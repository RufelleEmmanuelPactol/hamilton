{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Pink Console",
  "version": "1.0.0",
  "color": {
    "bg":        { "$value": "#F7F8FA", "$description": "App background behind panels" },
    "panel":     { "$value": "#FFFFFF", "$description": "Cards, tables, sidebar, header" },
    "sub":       { "$value": "#F9FAFB", "$description": "Table headers, group rows, quiet fills" },
    "line":      { "$value": "#E4E7EC", "$description": "Hairlines, card borders, row dividers" },
    "line2":     { "$value": "#D0D5DD", "$description": "Control borders (inputs, selects, secondary buttons)" },
    "ink":       { "$value": "#101828", "$description": "Primary text" },
    "ink2":      { "$value": "#344054", "$description": "Secondary text, body copy in dense areas" },
    "mute":      { "$value": "#667085", "$description": "Labels, meta, captions" },
    "brand":     { "$value": "#E91E63", "$description": "Logo, AI sparkle, progress, the 'now' line. Not for text on white." },
    "brandInk":  { "$value": "#C2185B", "$description": "Primary buttons, links, active nav. Passes AA on white." },
    "brandTint": { "$value": "#FDECF3", "$description": "Active nav fill, selected row, suggestion highlight" },
    "aiBg":      { "$value": "#FFF7FA", "$description": "Panel fill for AI-generated content" },
    "aiLine":    { "$value": "#F8BBD0", "$description": "Border for AI-generated content" },
    "status": {
      "ok":   { "fg": { "$value": "#067647" }, "bg": { "$value": "#ECFDF3" }, "line": { "$value": "#ABEFC6" } },
      "warn": { "fg": { "$value": "#B54708" }, "bg": { "$value": "#FFFAEB" }, "line": { "$value": "#FEDF89" } },
      "err":  { "fg": { "$value": "#B42318" }, "bg": { "$value": "#FEF3F2" }, "line": { "$value": "#FECDCA" } },
      "info": { "fg": { "$value": "#175CD3" }, "bg": { "$value": "#EFF8FF" }, "line": { "$value": "#B2DDFF" } },
      "neutral": { "fg": { "$value": "#344054" }, "bg": { "$value": "#F2F4F7" }, "line": { "$value": "#D0D5DD" } }
    },
    "series": {
      "$description": "Categorical colors for people, routes and chart series. Assign in this order and keep them stable per entity.",
      "1": { "$value": "#2E90FA" },
      "2": { "$value": "#7A5AF8" },
      "3": { "$value": "#E91E63" },
      "4": { "$value": "#F79009" },
      "5": { "$value": "#12B76A" },
      "6": { "$value": "#0BA5EC" }
    }
  },
  "font": {
    "sans": { "$value": "'IBM Plex Sans', system-ui, sans-serif" },
    "mono": { "$value": "'IBM Plex Mono', ui-monospace, monospace", "$description": "IDs, times, numbers in tables" },
    "user": { "$value": "system-ui, sans-serif", "$description": "Text people wrote themselves (customer messages)" }
  },
  "type": {
    "pageTitle":  { "size": "20px", "weight": 600, "tracking": "-0.01em" },
    "sectionTitle": { "size": "14px", "weight": 600 },
    "body":       { "size": "13px", "weight": 400, "lineHeight": 1.5 },
    "small":      { "size": "12px", "weight": 400 },
    "tag":        { "size": "11px", "weight": 500 },
    "overline":   { "size": "11px", "weight": 600, "tracking": "0.04em", "transform": "uppercase" },
    "metric":     { "size": "20-22px", "weight": 600 }
  },
  "radius": { "tag": "4px", "control": "6px", "card": "8px", "phone": "10px", "pill": "99px" },
  "space":  { "1": "4px", "2": "8px", "3": "12px", "4": "14px", "5": "16px", "6": "20px", "7": "24px" },
  "size": {
    "header": "52px", "sidebar": "220-236px", "navItem": "32px",
    "buttonPage": "34px", "buttonInline": "28-30px", "input": "32-36px",
    "touchTarget": "44px", "avatarSm": "22px", "avatar": "26px"
  },
  "shadow": {
    "raised":  { "$value": "0 1px 2px rgba(16,24,40,.12)", "$description": "Selected segment, floating chip" },
    "popover": { "$value": "0 12px 24px rgba(16,24,40,.14)" }
  },
  "motion": { "pulse": "1.6s ease-out infinite", "$description": "Only for live position markers" }
}
